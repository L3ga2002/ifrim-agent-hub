{
  "version": 1,
  "note": "Skills are versioned procedures. Agents may propose changes (skill_proposals); only the user approves them. A skill never raises its own permission tier.",
  "skills": [
    { "id": "debug", "version": 1, "name": "Debug", "roles": ["backend", "frontend", "qa"], "permission": "WORKSPACE_EDIT",
      "inputs": ["symptom", "reproduction steps or logs (authorized)", "expected behaviour"],
      "outputs": ["root cause with evidence", "fix", "regression test", "report"],
      "steps": ["Reproduce locally without models when possible", "Form hypotheses and test them one by one", "Fix the root cause, not the symptom", "Add a regression test that fails before the fix", "Run the full relevant suite"],
      "tools": ["files.read", "files.edit", "process.test", "git.diff"],
      "tests": ["regression test fails on the old code and passes on the new code", "no unrelated files changed"] },
    { "id": "feature", "version": 1, "name": "Feature", "roles": ["planner", "frontend", "backend", "reviewer", "qa"], "permission": "WORKSPACE_EDIT",
      "inputs": ["request", "acceptance criteria"], "outputs": ["implementation", "tests", "review verdict", "QA evidence"],
      "steps": ["Plan scope and non-goals", "Implement with validation, loading/empty/error states", "Deterministic tests before AI review", "Independent review", "QA against acceptance criteria"],
      "tools": ["files.read", "files.edit", "process.build", "process.test", "preview.check"],
      "tests": ["every acceptance criterion has a PASS/FAIL line", "build passes"] },
    { "id": "review", "version": 1, "name": "Review", "roles": ["reviewer", "security"], "permission": "READ_ONLY",
      "inputs": ["diff or commit", "task acceptance criteria"], "outputs": ["GO/NO_GO verdict", "findings with file:line"],
      "steps": ["Assume the change may be wrong", "Check correctness, edge cases, tests, security", "Rank findings by severity"],
      "tools": ["files.read", "git.diff"], "tests": ["verdict line present", "each finding has a location"] },
    { "id": "test-browser", "version": 1, "name": "Browser test", "roles": ["qa"], "permission": "DEVELOPMENT_TOOLS",
      "inputs": ["local preview URL", "flows to check"], "outputs": ["screenshots at 360/390/768/1024/1440/1920", "console errors", "pass/fail per flow"],
      "steps": ["Open only local/allowed URLs", "Exercise each flow", "Check overflow, contrast, focus", "Record evidence"],
      "tools": ["preview.check", "browser.inspect"], "tests": ["no page-level horizontal overflow at 360px", "no uncaught console errors"] },
    { "id": "audit-site", "version": 1, "name": "Site audit", "roles": ["website-auditor"], "permission": "READ_ONLY",
      "inputs": ["business name", "candidate domain"], "outputs": ["verified business + domain with source/date", "findings", "separate suggestions"],
      "steps": ["Identify the business and confirm the domain with a dated source", "Measure, do not guess", "Separate findings from suggestions"],
      "tools": ["browser.inspect", "memory.search"], "tests": ["domain confirmation has a source", "no invented metrics"] },
    { "id": "site-premium", "version": 1, "name": "Premium site", "roles": ["planner", "design", "frontend", "qa"], "permission": "WORKSPACE_EDIT",
      "inputs": ["client brief", "content provided by the client"], "outputs": ["structure", "design tokens", "implementation", "responsive verification"],
      "steps": ["Brief and structure", "Design direction and tokens", "Implementation", "Responsive and accessibility verification"],
      "tools": ["files.read", "files.edit", "process.build", "preview.check"], "tests": ["no fictional testimonials", "responsive widths verified"] },
    { "id": "company-research", "version": 1, "name": "Company research", "roles": ["research", "sales-assistant"], "permission": "READ_ONLY",
      "inputs": ["company name or domain"], "outputs": ["facts with source and date", "open questions"],
      "steps": ["Collect only sourced facts", "Mark unknowns as unknown"], "tools": ["memory.search"],
      "tests": ["every fact has a source", "no invented revenue, administrators or contacts"] },
    { "id": "offer", "version": 1, "name": "Offer draft", "roles": ["sales-assistant"], "permission": "READ_ONLY",
      "inputs": ["scope", "verified client context"], "outputs": ["offer draft (not sent)"],
      "steps": ["Draft from verified context", "Flag assumptions", "Hand to the user for review"], "tools": ["memory.search"],
      "tests": ["draft is labelled DRAFT", "nothing is sent"] },
    { "id": "documentation", "version": 1, "name": "Documentation", "roles": ["documentation"], "permission": "WORKSPACE_EDIT",
      "inputs": ["verified state"], "outputs": ["updated docs"], "steps": ["Update without deleting history", "Link evidence"],
      "tools": ["files.read", "files.edit"], "tests": ["history sections preserved"] },
    { "id": "release", "version": 1, "name": "Release", "roles": ["devops", "qa"], "permission": "EXTERNAL_ACTIONS",
      "inputs": ["verified build", "release notes"], "outputs": ["release checklist", "prepared commands (not executed)"],
      "steps": ["Verify tests/build/restore", "Prepare commit/tag/deploy commands", "Request action-bound approval for each external step"],
      "tools": ["git.status", "git.diff"], "tests": ["no push/deploy without an approval bound to the exact command"] },
    { "id": "handoff", "version": 1, "name": "Handoff", "roles": ["project-manager"], "permission": "READ_ONLY",
      "inputs": ["conversation", "task"], "outputs": ["HandoffPackage", "acknowledgement check"],
      "steps": ["Freeze scheduling", "Reach a safe point", "Reconcile processes", "Checkpoint", "Package", "Transfer write exclusivity", "Start target only if authorized", "Verify acknowledgement", "Continue in the same conversation"],
      "tools": ["git.status", "git.diff"], "tests": ["objective and constraints survive round trip", "no secrets in the package"] }
  ]
}

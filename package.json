{
  "name": "ifrim-agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:api": "node apps/api/src/server.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 3004",
    "hub:tray": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/agent-hub-tray.ps1 -OpenDashboard",
    "hub:install-startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/install-agent-hub-autostart.ps1 -StartNow",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3004"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.3"
  }
}
